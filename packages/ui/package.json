{
  "name": "@repo/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.umd.js",
  "types": "./dist/ui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.ums.js"
    },
    "./style.css": "./dist/ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "api-extractor": "api-extractor run --local --verbose",
    "dev": "tsc --watch",
    "build": "vite build && tsc --project tsconfig.build.json && pnpm run api-extractor",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest",
    "test:storybook": "vitest --project=storybook",
    "test:helpers": "vitest --project=helpers",
    "test:helpers-browser": "vitest --project=helpers-browser"
  },
  "dependencies": {
    "@heroicons/react": "catalog:",
    "luxon": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@eslint/js": "catalog:",
    "@mareuter/eslint-config": "catalog:",
    "@mareuter/prettier-config": "catalog:",
    "@mareuter/typescript-config": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@repo/data": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-console": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-only-warn": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "globals": "catalog:",
    "playwright": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "lint-staged": {
    "**/*.{json,md,css}": [
      "pnpm format"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  }
}
