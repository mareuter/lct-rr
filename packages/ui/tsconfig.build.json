{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",

    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,

    "verbatimModuleSyntax": false,

    "rootDir": ".",
    "outDir": "dist"
  },
  "exclude": ["lib/tests"]
}
