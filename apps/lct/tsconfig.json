{
  "extends": "@mareuter/typescript-config/tsc/dom/react",
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "types": ["node", "vite/client"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "~/*": ["./app/*"]
    },
    "noEmit": true
  }
}
