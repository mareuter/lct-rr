{
  "name": "lct-rr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "view-report": "turbo run view-report",
    "prepare": "husky",
    "storybook": "turbo run storybook"
  },
  "devDependencies": {
    "@mareuter/prettier-config": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@12.16.0+sha512.e9ccc91a0b8d52da297c16841f9ee05f3ddd631bd757ef26a211687d4a38de653c614453649294438c58be74c2ba62d53e633a4e153708c012296d0f3ee27b36",
  "engines": {
    "node": ">=24 <26"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{json,md}": [
      "prettier --write"
    ],
    "**/*/*.{json,md,css}": [
      "turbo run format"
    ],
    "**/*.{ts,tsx,js,jsx}": [
      "turbo run lint:fix",
      "turbo run format"
    ]
  }
}
