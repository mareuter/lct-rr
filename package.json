{
  "name": "lct-rr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "start": "turbo run start",
    "test": "turbo run test",
    "view-report": "turbo run view-report",
    "prepare": "husky",
    "storybook": "turbo run storybook"
  },
  "devDependencies": {
    "@mareuter/prettier-config": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24 <26"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{json,md}": [
      "prettier --write"
    ],
    "**/*/*.{json,md,css}": [
      "turbo run format"
    ],
    "**/*.{ts,tsx,js,jsx}": [
      "turbo run lint:fix",
      "turbo run format"
    ]
  }
}
