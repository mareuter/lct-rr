{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "with": ["@repo/ui#dev"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$"],
      "dependsOn": ["transit"],
      "outputs": ["coverage.json"],
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "storybook": {
      "dependsOn": ["^storybook"]
    },
    "start": {
      "dependsOn": ["transit", "@repo/ui#build", "lct#build"],
      "persistent": true
    }
  }
}
